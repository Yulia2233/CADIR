{
  "$schema": "https://opencode.ai/config.json",
  "model": "cadir/gpt-5.6-sol",
  "default_agent": "cadir-agent",
  "subagent_depth": 0,
  "share": "disabled",
  "provider": {
    "cadir": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CADIR OpenAI-compatible server",
      "options": {
        "baseURL": "{env:CADIR_LLM_BASE_URL}",
        "apiKey": "{env:CADIR_LLM_API_KEY}"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        }
      }
    }
  },
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true },
    "scout": { "disable": true }
  },
  "permission": {
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "workspace/jobs/**/.cadir/**"]
  }
}
