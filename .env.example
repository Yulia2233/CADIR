# Copy to .env on the deployment host. Never commit the real values.
CADIR_LLM_BASE_URL=https://openrouter.icu/v1
CADIR_LLM_API_KEY=

# Use independent random values in production.
INTERNAL_API_TOKEN=replace-with-a-long-random-internal-token
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-a-long-random-password

CADIR_WEB_PORT=5173
CADIR_API_PORT=3001
CADIR_RUN_TIMEOUT_SECONDS=180
# The Docker deployment uses the cadir-rag-library named volume for durable archives.

# The retrieval API is a separately deployed service on the cadir-internal network.
RETRIEVAL_URL=http://retrieval-api:8000
RETRIEVAL_TIMEOUT_MS=30000
RETRIEVAL_TOP_K=5
